# Copy to .env and fill in. Never commit .env. For Streamlit Cloud, run `python scripts/make_secrets.py` and paste .streamlit/secrets.toml into the app's Secrets.

# Required
ANTHROPIC_API_KEY=your-key-here

# Model (shipped default: Claude Haiku 5.5). Thinking counts toward LLM_MAX_TOKENS.
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=1000
# LLM_EFFORT=low            # optional: low | medium | high (empty = model default)

# Retrieval
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
USE_EMBEDDINGS=true         # false = keyword-only (what Streamlit Cloud runs)
SCOPE_MIN_SIMILARITY=0.27   # hybrid only: off-topic threshold, tuned on the eval

# Public demo protections
MAX_QUESTION_CHARS=500
MAX_QUESTIONS_PER_SESSION=20
MAX_QUESTIONS_PER_DAY=200
LOG_MAX_ENTRIES=5000

# Cost estimates on the Admin page (USD per million tokens; Claude Haiku 5.5 prices)
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.50

# Owner-only Admin page. Leave empty to remove the page entirely. Use a long random value.
ADMIN_PASSWORD=
ADMIN_IDLE_MINUTES=30       # the Admin page signs out after this long without activity

# Admin page warnings (errors today / (questions + errors), and estimated cost today in USD)
ALERT_ERROR_RATE=0.2
ALERT_MIN_EVENTS=5
ALERT_DAILY_COST_USD=1.00

# Optional: where logs and the daily counter are written (default: data/)
# LOG_DIR=data
